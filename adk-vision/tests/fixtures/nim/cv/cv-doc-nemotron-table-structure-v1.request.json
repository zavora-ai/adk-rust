{
  "method": "POST",
  "url": "https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-table-structure-v1",
  "headers": {
    "Accept": "application/json",
    "Authorization": "Bearer ${NVIDIA_API_KEY}",
    "Content-Type": "application/json"
  },
  "body": {
    "input": [
      {
        "type": "image_url",
        "url": "{{datauri:image/png:doc-table-crop-860x300.png}}"
      }
    ]
  },
  "bodyNote": "Placeholders {{b64:<file>}} / {{datauri:<mime>:<file>}} expand to the named fixture image under images/."
}
