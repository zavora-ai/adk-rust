{
  "name": "F-4: Tool Confirmation",
  "description": "Agent invokes a tool requiring confirmation. The turn ends with requires_action until the user approves, then a resumed turn executes the held call and continues. Validates the confirmation flow.",
  "agent_def": {
    "name": "confirmation-agent",
    "model": "gemini-3.7-flash",
    "system": "You have access to a bash tool that requires confirmation.",
    "tools": [
      {
        "type": "bash"
      }
    ],
    "permission_policy": {
      "default": "auto_approve",
      "tools": {
        "bash": "prompt"
      }
    }
  },
  "scripted_model": {
    "turns": [
      {
        "text": null,
        "tool_calls": [
          {
            "name": "bash",
            "input": {
              "command": "echo deleted"
            },
            "id": "tu_delete_001"
          }
        ]
      },
      {
        "text": "Done. The command ran after your approval.",
        "tool_calls": []
      }
    ]
  },
  "scenario": [
    {
      "type": "user.message",
      "content": [
        {
          "type": "text",
          "text": "Run the cleanup command"
        }
      ]
    },
    {
      "type": "user.tool_confirmation",
      "tool_use_id": "tu_delete_001",
      "result": "allow"
    }
  ],
  "assertions": {
    "exact_sequence": [
      "status.running",
      "agent.tool_use",
      "status.idle",
      "status.running",
      "agent.message",
      "status.idle"
    ],
    "must_contain": [
      "agent.tool_use",
      "agent.message"
    ],
    "must_end_with": [
      "status.idle"
    ]
  }
}
