# Read by the agent at start, and by `docker compose` for the secrets in compose.yaml.
ANTHROPIC_API_KEY=
# The bearer token callers present; holders get the admin scope the kill switch needs.
ADK_API_TOKEN=
# The session store's connection URL, read as ADK_SERVICE_SESSIONS_URL inside the container.
SESSIONS_DATABASE_URL=sqlite:///data/sessions.db?mode=rwc
