# Gemini API key for the LLM provider (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# Google Cloud project that owns the RAG corpus
GOOGLE_CLOUD_PROJECT=my-project

# Region the corpus lives in
GOOGLE_CLOUD_LOCATION=us-central1

# RAG corpus ID (the last resource-name segment) or the full
# projects/*/locations/*/ragCorpora/* resource name. The corpus must be
# pre-provisioned with imported files.
VERTEX_RAG_CORPUS=1234567890

# Optional: the question to ask the agent
# RAG_QUESTION=What is our refund policy?
