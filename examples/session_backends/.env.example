# Optional: enables cluster_multi_turn_live (OpenAI through OpenAIClient, model gpt-5.6-terra)
OPENAI_API_KEY=

# Servers; a scenario whose server is unset is skipped
# REDIS_URL=redis://127.0.0.1:6380
# REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003
# POSTGRES_URL=postgres://postgres@127.0.0.1:5432/adk_sessions

# Optional: label the standalone session this run seeds, or require one seeded by that label
# SESSION_SEED_LABEL=main
# EXPECT_SEED_FROM=main

# Optional: load keys from another dotenv file instead of ./.env
# ADK_ENV_FILE=/path/to/.env
