# Optional: enables live_escalated_payment_resumes (OpenAI through OpenAIClient)
OPENAI_API_KEY=

# Optional model override for the live scenario
# OPENAI_MODEL=gpt-5.6-terra

# Optional: runs the session identifier checks against a Redis server
# REDIS_URL=redis://127.0.0.1:6379

# Optional: load keys from another dotenv file instead of ./.env or the repository's .env
# ADK_ENV_FILE=/path/to/.env
