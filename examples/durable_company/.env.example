# Required for --provider openai
OPENAI_API_KEY=
# Required for --provider anthropic
ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_MODEL=claude-haiku-5-5

# Required for --store postgres; the example creates its tables in a new schema per run
# DATABASE_URL=postgres://postgres@localhost:5432/postgres

# Optional: the adk-rust CLI (cargo build -p adk-cli --features audit-sql) that exports
# and verifies the audit logs; without it the example uses the library
# ADK_RUST_BIN=target/debug/adk-rust

# Optional: load keys from another dotenv file instead of ./.env
# ADK_ENV_FILE=/path/to/.env
