# Optional: live scenarios run when these are set; the rest run without keys.
# B1, B2, D2, E5 use Gemini (gemini-3.5-flash-lite, gemini-3.7-flash).
GEMINI_API_KEY=
# C5 uses OpenAI (gpt-5.6-terra).
OPENAI_API_KEY=
# G7 uses Anthropic (claude-sonnet-5-5); G1–G4 send a deliberately invalid key and need none.
# E6–E9 use Anthropic (claude-sonnet-5-5).
ANTHROPIC_API_KEY=
