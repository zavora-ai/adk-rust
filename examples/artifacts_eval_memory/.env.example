# Required for --provider gemini (the default); GOOGLE_API_KEY is read when GEMINI_API_KEY is unset
GEMINI_API_KEY=
# Required for --provider openai or --judge openai
OPENAI_API_KEY=
# Required for --provider anthropic or --judge anthropic
ANTHROPIC_API_KEY=

# Optional: load keys from another dotenv file instead of ./.env; its values win over
# variables already set in the environment
# ADK_ENV_FILE=/path/to/.env
