# OpenAI Realtime API
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Gemini Live API
GOOGLE_API_KEY=your-google-api-key-here

# Server port (default 3033)
PORT=3033

# Address to listen on (default 127.0.0.1). 0.0.0.0 exposes the unauthenticated
# server on every interface.
BIND_HOST=127.0.0.1

# Logging
RUST_LOG=info
