# Optional: enables the live_openai_* scenarios (OpenAI Chat Completions and the OpenAI Realtime API)
OPENAI_API_KEY=

# Optional: enables the live_anthropic_* scenarios (Anthropic Messages API)
ANTHROPIC_API_KEY=

# Optional: load keys from another dotenv file instead of the repository's .env
# ADK_ENV_FILE=/path/to/.env
