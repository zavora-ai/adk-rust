OPENAI_API_KEY=your-api-key
# Optional chat and realtime model overrides.
ADVANCED_CHAT_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Six-field schedule; default is every 30 seconds for UI demonstrations.
ADVANCED_AMBIENT_CRON=*/30 * * * * *
# Optional runtime address and public A2A base URL.
ADK_UI_ADDRESS=127.0.0.1:8088
ADK_A2A_BASE_URL=http://127.0.0.1:8088
