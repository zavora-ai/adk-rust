# Only `--live` needs a key; the `adk-rust up` binary the scenario starts inherits it.
# The scenario reads the repository's .env, or the file SCENARIO_ENV_FILE names.
GOOGLE_API_KEY=
# `--provider anthropic`.
ANTHROPIC_API_KEY=
# `--store postgres`: a PostgreSQL server the scenario may create a database on.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Another adk-rust binary than ../../target/debug/adk-rust.
# ADK_RUST_BIN=
