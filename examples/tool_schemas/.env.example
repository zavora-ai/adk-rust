# Optional: enables live_openai_schema (OpenAI Chat Completions through OpenAIClient)
OPENAI_API_KEY=

# Optional: enables live_gemini_schema (Gemini through GeminiModel)
GOOGLE_API_KEY=

# Optional: read keys from this dotenv file instead of the repository's .env.
# Values in the file override variables already exported by the shell.
# ADK_ENV_FILE=/absolute/path/to/.env
