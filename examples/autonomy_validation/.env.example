# Required for the OpenAI columns (openai, openai-chat)
OPENAI_API_KEY=
# Required for the Anthropic column
ANTHROPIC_API_KEY=
# Required for the Gemini column (GOOGLE_API_KEY is read when GEMINI_API_KEY is unset)
GEMINI_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_ROUTED_MODEL=gpt-5.6-luna
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WEB_MODEL=claude-sonnet-5-5
# ANTHROPIC_THINKING_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: load keys from another dotenv file instead of ./.env; its values win over
# variables already set in the environment
# ADK_ENV_FILE=/path/to/.env
