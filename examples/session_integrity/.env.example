# Optional: enables live_recovery (OpenAI through OpenAIClient, model gpt-5.6-terra)
OPENAI_API_KEY=

# Servers; a backend whose URL is unset is skipped
# POSTGRES_URL=postgres://adk@127.0.0.1:5432/sessions
# REDIS_URL=redis://127.0.0.1:6379

# Optional: load keys from another dotenv file instead of ./.env
# ADK_ENV_FILE=/path/to/.env
