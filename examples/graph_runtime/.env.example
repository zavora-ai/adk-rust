# Optional: enables the live_* scenarios that run on Gemini through GeminiModel
GOOGLE_API_KEY=

# Optional model override for the live scenarios
# GEMINI_MODEL=gemini-3.5-flash-lite

# The Redis server for --checkpointer redis
# REDIS_URL=redis://127.0.0.1:6379

# Optional: load keys from another dotenv file instead of ./.env
# ADK_ENV_FILE=/path/to/.env
