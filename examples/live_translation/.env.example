# OpenAI gpt-realtime-translate (provider=openai)
OPENAI_API_KEY=sk-your-openai-key-here

# Gemini Live Translate (provider=gemini); GOOGLE_API_KEY is also accepted
GEMINI_API_KEY=your-google-api-key-here

# Server port (default 3055)
PORT=3055

# Address to listen on (default 127.0.0.1). 0.0.0.0 exposes the unauthenticated
# server on every interface.
BIND_HOST=127.0.0.1

RUST_LOG=info
