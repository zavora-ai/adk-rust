{
  "components": {
    "schemas": {
      "ComingUpItem": {
        "description": "Something in the caller's Coming up, and the times it may move to (spec 3.3 §5.1).",
        "properties": {
          "area": {
            "description": "The area it is in.",
            "type": "string"
          },
          "at": {
            "description": "When it wakes, when it waits for one time.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "atText": {
            "description": "When it wakes, as a person reads it: \"18:00\", \"Tue 18:00\"; empty without one time.",
            "type": "string"
          },
          "choices": {
            "description": "The times it may move to: an hour later, the same time tomorrow — those before it ends.",
            "items": {
              "$ref": "#/components/schemas/SnoozeChoice"
            },
            "type": "array"
          },
          "ends": {
            "description": "When it ends if it has not run.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "The agenda item's id.",
            "type": "string"
          },
          "title": {
            "description": "Its title.",
            "type": "string"
          },
          "whyNot": {
            "description": "Why it cannot be snoozed, in plain words; absent when it can.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "area",
          "atText",
          "choices"
        ],
        "type": "object"
      },
      "ObjectKind": {
        "description": "What a screen action acts on (spec 3.3 §2 item 7). This wave allows only Coming up.",
        "oneOf": [
          {
            "const": "comingUp",
            "description": "Something in Coming up: an agenda item scheduled to run (spec 3.3 §5.1).",
            "type": "string"
          }
        ]
      },
      "ObjectRef": {
        "description": "One thing an action acts on (spec 3.3 §2 item 7).",
        "properties": {
          "id": {
            "description": "Its id: the agenda item's id for Coming up.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ObjectKind",
            "description": "What kind of thing."
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "Origin": {
        "description": "How an input was given (spec 3.3 §6, §11): every command carries one, and it reaches the\naudit record, so \"What your agents did\" can say \"from Telegram\".",
        "oneOf": [
          {
            "description": "Typed.",
            "properties": {
              "kind": {
                "const": "keyboard",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Clicked.",
            "properties": {
              "kind": {
                "const": "pointer",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Tapped.",
            "properties": {
              "kind": {
                "const": "touch",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Spoken.",
            "properties": {
              "kind": {
                "const": "voice",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Sent from a chat channel.",
            "properties": {
              "channel": {
                "description": "The channel's name, such as `Telegram`.",
                "type": "string"
              },
              "kind": {
                "const": "chat",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "channel"
            ],
            "type": "object"
          },
          {
            "description": "Requested by an agent (spec 3.3 §7.4 rule 6: never an answer to a decision).",
            "properties": {
              "agent": {
                "description": "The requesting agent.",
                "type": "string"
              },
              "kind": {
                "const": "agent",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "agent"
            ],
            "type": "object"
          }
        ]
      },
      "SnoozeChoice": {
        "description": "One time an item may move to (spec 3.3 §5.1).",
        "properties": {
          "atText": {
            "description": "The new time as a person reads it: \"19:00\", \"Tue 18:00\".",
            "type": "string"
          },
          "label": {
            "description": "\"1 hour later\" or \"Tomorrow, same time\".",
            "type": "string"
          },
          "to": {
            "description": "The new time, the `to` of `snooze`.",
            "format": "date-time",
            "type": "string"
          },
          "tomorrow": {
            "description": "It is the same time tomorrow.",
            "type": "boolean"
          }
        },
        "required": [
          "to",
          "label",
          "atText",
          "tomorrow"
        ],
        "type": "object"
      },
      "SurfaceKind": {
        "description": "The surface a person uses (spec 3.3 §5, §7.2).\n\nWhat a surface may decide is fixed by §7.2 and computed by\n`rules::allowed_answers`; a surface never grants more\nthan the web home.",
        "oneOf": [
          {
            "const": "web",
            "description": "The web home (spec 3.3 §5.1).",
            "type": "string"
          },
          {
            "const": "terminal",
            "description": "The terminal (spec 3.3 §5.2).",
            "type": "string"
          },
          {
            "const": "phone",
            "description": "The web home installed on a phone (spec 3.3 §5.4).",
            "type": "string"
          },
          {
            "const": "tray",
            "description": "The desktop tray (spec 3.3 §5.5).",
            "type": "string"
          },
          {
            "const": "chat",
            "description": "A chat channel (spec 3.3 §5.3).",
            "type": "string"
          },
          {
            "const": "voice",
            "description": "Voice and video (spec 3.3 §5.6).",
            "type": "string"
          }
        ]
      },
      "VerbCallRequest": {
        "description": "`POST /surface/verbs/call` body: the action, and the surface it was given on and how. The\ncaller is the server's; a declared surface or origin only says where the person was.",
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/VerbIntent",
            "description": "The action."
          },
          "origin": {
            "$ref": "#/components/schemas/Origin",
            "description": "How the input was given."
          },
          "surface": {
            "$ref": "#/components/schemas/SurfaceKind",
            "default": "web",
            "description": "The surface; defaults to the web home."
          }
        },
        "required": [
          "origin",
          "intent"
        ],
        "type": "object"
      },
      "VerbDone": {
        "description": "What an action did (spec 3.3 §2 item 7): shown once it ran, never before.",
        "properties": {
          "result": {
            "default": null,
            "description": "What a read returned, or the changed thing; `null` when nothing more."
          },
          "target": {
            "description": "What it acted on: `agenda:<id>`.",
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "description": "What happened, in plain words: \"Moved News digest to 19:00\".",
            "type": "string"
          },
          "title": {
            "description": "What it acted on, in plain words: the item's title.",
            "type": [
              "string",
              "null"
            ]
          },
          "verb": {
            "description": "The action.",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "text",
          "result"
        ],
        "type": "object"
      },
      "VerbIntent": {
        "description": "A request to take an action (spec 3.3 §2 item 7): the shape of agentrix's `VerbIntent`,\nre-declared. It carries no origin and no surface: those come from the server-authenticated\n`Caller`.\n\nThe arguments are the action's own; an object the action acts on fills the argument\n`item` when the arguments leave it out.",
        "properties": {
          "args": {
            "default": null,
            "description": "Its arguments."
          },
          "objects": {
            "default": [],
            "description": "What it acts on.",
            "items": {
              "$ref": "#/components/schemas/ObjectRef"
            },
            "type": "array"
          },
          "target": {
            "description": "The record's target, `agenda:<id>`; filled from `objects` when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "verb": {
            "description": "The action's name.",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "VerbView": {
        "description": "One action of the catalogue, as `GET /surface/verbs` lists it (spec 3.3 §6.1).",
        "properties": {
          "agentsAsk": {
            "description": "Agents may ask for it; it always waits for a person when it changes something.",
            "type": "boolean"
          },
          "description": {
            "description": "What it does.",
            "type": "string"
          },
          "effect": {
            "description": "What it changes: `read`, `write_local`, …",
            "type": "string"
          },
          "label": {
            "description": "The button's words.",
            "type": "string"
          },
          "name": {
            "description": "The name.",
            "type": "string"
          },
          "objects": {
            "description": "What it acts on.",
            "items": {
              "$ref": "#/components/schemas/ObjectKind"
            },
            "type": "array"
          },
          "onlyDelays": {
            "description": "It only delays work, so it still runs while everything is stopped.",
            "type": "boolean"
          },
          "reversible": {
            "description": "It can be changed back.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "label",
          "description",
          "objects",
          "effect",
          "agentsAsk",
          "onlyDelays",
          "reversible"
        ],
        "type": "object"
      },
      "VerbsResponse": {
        "description": "`GET /surface/verbs` answer (spec 3.3 §2 item 7).",
        "properties": {
          "comingUp": {
            "description": "The caller's Coming up, soonest first, with the times each item may move to.",
            "items": {
              "$ref": "#/components/schemas/ComingUpItem"
            },
            "type": "array"
          },
          "verbs": {
            "description": "The actions this home offers.",
            "items": {
              "$ref": "#/components/schemas/VerbView"
            },
            "type": "array"
          }
        },
        "required": [
          "verbs",
          "comingUp"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Screen actions people and agents share (spec 3.3 §2 item 7): the catalogue, Coming up and taking an action. Generated from the Rust types; do not edit.",
    "title": "adk-surface screen actions",
    "version": "3.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/surface/verbs": {
      "get": {
        "parameters": [
          {
            "description": "The surface asking; chat and the tray list nothing to act on",
            "in": "query",
            "name": "surface",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SurfaceKind"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerbsResponse"
                }
              }
            },
            "description": "The catalogue and Coming up"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          }
        },
        "summary": "The screen actions this home offers, and the caller's Coming up with the times each item may move to (spec 3.3 §2 item 7)"
      }
    },
    "/api/surface/verbs/call": {
      "post": {
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerbCallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerbDone"
                }
              }
            },
            "description": "What it did"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A problem document with the engine's `surface.*` code, or the source's"
          }
        },
        "summary": "Takes a screen action as the authenticated person, through the governed path; answers once it ran. A declared voice or agent origin, or the voice or chat surface, answers 400"
      }
    },
    "/api/surface/verbs/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "The OpenAPI document"
          }
        },
        "summary": "This document"
      }
    }
  }
}
