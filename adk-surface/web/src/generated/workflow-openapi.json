{
  "components": {
    "schemas": {
      "Change": {
        "description": "How a state key changed in a step.",
        "oneOf": [
          {
            "const": "added",
            "description": "The key was not in the state before.",
            "type": "string"
          },
          {
            "const": "changed",
            "description": "The key's value changed.",
            "type": "string"
          },
          {
            "const": "removed",
            "description": "The key is not in the state after.",
            "type": "string"
          }
        ]
      },
      "ChannelValue": {
        "description": "One channel's value at a checkpoint, for the fork dialog's editor.",
        "properties": {
          "key": {
            "description": "The channel.",
            "type": "string"
          },
          "note": {
            "description": "Why the value is not shown as it is.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "description": "Its value, shown as every value is; `null` when the state does not hold it."
          }
        },
        "required": [
          "key",
          "value"
        ],
        "type": "object"
      },
      "EdgeView": {
        "description": "One edge of a `GraphView`.",
        "properties": {
          "conditional": {
            "description": "Whether a router chooses the edge at run time.",
            "type": "boolean"
          },
          "from": {
            "description": "The node the edge leaves.",
            "type": "string"
          },
          "to": {
            "description": "The node the edge reaches, or `__end__`.",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "conditional"
        ],
        "type": "object"
      },
      "EffectView": {
        "description": "A governed call that already happened, from the effect log (spec 3.3 §12).",
        "properties": {
          "at": {
            "description": "When it happened.",
            "format": "date-time",
            "type": "string"
          },
          "atText": {
            "description": "`09:14`.",
            "type": "string"
          },
          "call": {
            "description": "The call in short: `POST 127.0.0.1/charges`.",
            "type": [
              "string",
              "null"
            ]
          },
          "node": {
            "description": "The governed node.",
            "type": "string"
          },
          "text": {
            "description": "\"pay — POST 127.0.0.1/charges at 09:14\".",
            "type": "string"
          },
          "writes": {
            "description": "The keys it wrote.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "node",
          "at",
          "atText",
          "writes",
          "text"
        ],
        "type": "object"
      },
      "ForkOutcome": {
        "description": "What a fork did (spec 3.3 §12).",
        "properties": {
          "edited": {
            "description": "The keys it overwrote.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "from": {
            "description": "The checkpoint it was forked from.",
            "type": "string"
          },
          "sessionId": {
            "description": "The fork's new session.",
            "type": "string"
          },
          "started": {
            "description": "Whether its run started.",
            "type": "boolean"
          },
          "text": {
            "description": "\"Forked. The original run is unchanged.\"",
            "type": "string"
          },
          "threadId": {
            "description": "Its checkpoint thread.",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "threadId",
          "from",
          "edited",
          "started",
          "text"
        ],
        "type": "object"
      },
      "ForkPoint": {
        "description": "What a fork from a step would do, for the fork dialog (spec 3.3 §12).",
        "properties": {
          "allowed": {
            "description": "Whether a fork may start here.",
            "type": "boolean"
          },
          "alreadyHappened": {
            "description": "Governed calls after this step that already happened and are answered from their\nrecord unless the fork changes them.",
            "items": {
              "$ref": "#/components/schemas/EffectView"
            },
            "type": "array"
          },
          "refusal": {
            "description": "Why not: \"Nothing runs after the last step\".",
            "type": [
              "string",
              "null"
            ]
          },
          "runsAgain": {
            "description": "The nodes that run again: `pay`, `receipt`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "allowed",
          "runsAgain",
          "alreadyHappened"
        ],
        "type": "object"
      },
      "ForkRequest": {
        "description": "`POST /surface/workflow/sessions/{session}/fork` (spec 3.3 §12).",
        "properties": {
          "from": {
            "description": "The completed checkpoint of the step to fork from.",
            "type": "string"
          },
          "set": {
            "additionalProperties": true,
            "default": {},
            "description": "Channels to overwrite in the fork, whole.",
            "type": "object"
          },
          "start": {
            "default": false,
            "description": "Start the fork's run now.",
            "type": "boolean"
          }
        },
        "required": [
          "from"
        ],
        "type": "object"
      },
      "ForkSummary": {
        "description": "A fork of a run, as \"Forks of this run\" lists it.",
        "properties": {
          "at": {
            "description": "When the fork started, or was made.",
            "format": "date-time",
            "type": "string"
          },
          "atText": {
            "description": "`09:31`.",
            "type": "string"
          },
          "edited": {
            "description": "The keys it overwrote.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parentStep": {
            "description": "The step it was forked at.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "sessionId": {
            "description": "The fork's session.",
            "type": "string"
          },
          "text": {
            "description": "\"from step 1 · edited note\".",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "at",
          "atText",
          "parentStep",
          "edited",
          "text"
        ],
        "type": "object"
      },
      "GraphView": {
        "description": "A graph agent the observer shows: its nodes, edges and channels (spec 3.3 §12).",
        "properties": {
          "channels": {
            "description": "The state channels the graph declares, which a fork may edit.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "The graph agent's description.",
            "type": "string"
          },
          "edges": {
            "description": "Every edge; `to` is `__end__` for an edge that ends a branch.",
            "items": {
              "$ref": "#/components/schemas/EdgeView"
            },
            "type": "array"
          },
          "entry": {
            "description": "The nodes a run starts with.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "description": "The graph agent's name: `invoice-run`.",
            "type": "string"
          },
          "nodes": {
            "description": "Every node, sorted by name.",
            "items": {
              "$ref": "#/components/schemas/NodeView"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "description",
          "nodes",
          "edges",
          "entry",
          "channels"
        ],
        "type": "object"
      },
      "GraphsResponse": {
        "description": "`GET /surface/workflow/graphs`.",
        "properties": {
          "graphs": {
            "description": "Every graph agent the home observes.",
            "items": {
              "$ref": "#/components/schemas/GraphView"
            },
            "type": "array"
          }
        },
        "required": [
          "graphs"
        ],
        "type": "object"
      },
      "NodeDecision": {
        "description": "The decision a governed node waited on, from the inbox.",
        "properties": {
          "id": {
            "description": "The decision's id.",
            "type": "string"
          },
          "text": {
            "description": "\"Asked at 09:14\", or who answered: \"You said yes from the home at 09:15\".",
            "type": "string"
          },
          "waiting": {
            "description": "Whether it still waits.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "waiting",
          "text"
        ],
        "type": "object"
      },
      "NodeDetail": {
        "description": "One node of a step detail.",
        "properties": {
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeDecision"
              },
              {
                "type": "null"
              }
            ],
            "description": "The decision a governed node waited on."
          },
          "effect": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EffectView"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a replayed call, the record that answered it: \"Not sent again — the record from\n09:14 answered it\"."
          },
          "kindText": {
            "description": "\"Model step\", \"HTTP call\", \"Function\".",
            "type": "string"
          },
          "modelStep": {
            "description": "A model step: its model and tool activity is in the session's thread.",
            "type": "boolean"
          },
          "run": {
            "$ref": "#/components/schemas/NodeRun",
            "description": "What became of the node."
          },
          "text": {
            "description": "A line under the node: \"Not sent again — the record from 09:14 answered it\".",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "run",
          "kindText",
          "modelStep"
        ],
        "type": "object"
      },
      "NodeRun": {
        "description": "One node's part in a run or a step (spec 3.3 §12).",
        "properties": {
          "attempt": {
            "description": "Its attempt count when it finished.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "decisionId": {
            "description": "The decision a waiting node waits on, from the inbox.",
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "description": "How long it ran, in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "durationText": {
            "description": "That duration in words: `1.2 s`.",
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "description": "The error it failed or was refused with.",
            "type": [
              "string",
              "null"
            ]
          },
          "inheritedText": {
            "description": "For a fork, the time the original run did this node: \"from 09:14\".",
            "type": [
              "string",
              "null"
            ]
          },
          "node": {
            "description": "The node's name.",
            "type": "string"
          },
          "startedAt": {
            "description": "When it started.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "startedText": {
            "description": "That time as the home shows it: `09:14:01`.",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/NodeState",
            "description": "What became of it."
          },
          "stateText": {
            "description": "In words: \"Done\", \"Waiting for you\", \"Not sent again\", \"Not run\", …",
            "type": "string"
          },
          "writes": {
            "description": "The state keys it wrote, sorted.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "node",
          "state",
          "stateText"
        ],
        "type": "object"
      },
      "NodeState": {
        "description": "What became of a node, as the run view shows it.",
        "oneOf": [
          {
            "const": "idle",
            "description": "Not reached.",
            "type": "string"
          },
          {
            "const": "working",
            "description": "Running now.",
            "type": "string"
          },
          {
            "const": "done",
            "description": "Finished.",
            "type": "string"
          },
          {
            "const": "waiting",
            "description": "A governed node waiting for its decision.",
            "type": "string"
          },
          {
            "const": "paused",
            "description": "Paused with a question.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "Failed.",
            "type": "string"
          },
          {
            "const": "recorded",
            "description": "A governed call that already happened, answered from its record.",
            "type": "string"
          },
          {
            "const": "notRun",
            "description": "Not run: refused, denied, or the step failed before it started.",
            "type": "string"
          }
        ]
      },
      "NodeView": {
        "description": "One node of a `GraphView`.",
        "properties": {
          "badges": {
            "description": "\"Asks first\", \"Spends money\", \"Can't be undone\".",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "The node's description.",
            "type": "string"
          },
          "kind": {
            "description": "What kind of step it is, as adk-graph names it: `modelStep`, `function`, `httpCall`, …",
            "type": "string"
          },
          "kindText": {
            "description": "The kind in words: \"Model step\", \"HTTP call\", \"Function\".",
            "type": "string"
          },
          "name": {
            "description": "The node's name.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "kind",
          "kindText",
          "badges"
        ],
        "type": "object"
      },
      "RunLineage": {
        "description": "Where a forked thread came from (spec 3.3 §12).",
        "properties": {
          "checked": {
            "description": "Whether the edits were checked against the graph's channels.",
            "type": "boolean"
          },
          "edited": {
            "description": "The keys the fork overwrote.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parent": {
            "description": "The thread this one was forked from.",
            "type": "string"
          },
          "parentCheckpoint": {
            "description": "The checkpoint of `parent` it was forked at.",
            "type": "string"
          },
          "parentSession": {
            "description": "The session of `parent`, when it is the caller's.",
            "type": [
              "string",
              "null"
            ]
          },
          "parentStep": {
            "description": "That checkpoint's step label.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "root": {
            "description": "The thread the family of forks started from.",
            "type": "string"
          },
          "text": {
            "description": "\"Fork of the 09:14 run at step 1 · edited note\".",
            "type": "string"
          }
        },
        "required": [
          "root",
          "parent",
          "parentCheckpoint",
          "parentStep",
          "edited",
          "checked",
          "text"
        ],
        "type": "object"
      },
      "RunStatus": {
        "description": "How a run stands (spec 3.3 §12).",
        "oneOf": [
          {
            "const": "noRun",
            "description": "The session's thread has no checkpoint yet.",
            "type": "string"
          },
          {
            "const": "notStarted",
            "description": "A fork made and not started.",
            "type": "string"
          },
          {
            "const": "working",
            "description": "A step is running.",
            "type": "string"
          },
          {
            "const": "waiting",
            "description": "A governed node waits for a decision.",
            "type": "string"
          },
          {
            "const": "paused",
            "description": "A node paused with a question that is not a decision.",
            "type": "string"
          },
          {
            "const": "stopped",
            "description": "Everything is stopped while the run has work left.",
            "type": "string"
          },
          {
            "const": "done",
            "description": "The run finished.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "A step failed.",
            "type": "string"
          }
        ]
      },
      "RunStep": {
        "description": "One step of a run, as the Steps list shows it (spec 3.3 §12).\n\nA step that paused and later completed is one row, addressed by its completed\ncheckpoint; \"Step n\" is a label, never an address.",
        "properties": {
          "at": {
            "description": "When it started.",
            "format": "date-time",
            "type": "string"
          },
          "atText": {
            "description": "That time as the home shows it: `09:14:01`.",
            "type": "string"
          },
          "checkpointId": {
            "description": "The checkpoint the step detail and a fork read: the completed checkpoint of the step,\nelse the one its pause or failure wrote. Absent for the input.",
            "type": [
              "string",
              "null"
            ]
          },
          "forkable": {
            "description": "Whether a fork may start here: a completed step with work after it.",
            "type": "boolean"
          },
          "label": {
            "description": "\"Step 1\".",
            "type": "string"
          },
          "nodes": {
            "description": "The step's nodes.",
            "items": {
              "$ref": "#/components/schemas/NodeRun"
            },
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/StepState",
            "description": "How the step ended."
          },
          "step": {
            "description": "The step's label.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "description": "\"Your message\" for the input, \"nothing written yet\" for a step that waits.",
            "type": [
              "string",
              "null"
            ]
          },
          "wrote": {
            "description": "The keys the step wrote, sorted.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "step",
          "label",
          "state",
          "at",
          "atText",
          "nodes",
          "wrote",
          "forkable"
        ],
        "type": "object"
      },
      "RunSummary": {
        "description": "One run of a session, as `GET …/runs` lists it, from its records only.",
        "properties": {
          "runId": {
            "description": "The run's id.",
            "type": "string"
          },
          "startedAt": {
            "description": "When it started.",
            "format": "date-time",
            "type": "string"
          },
          "startedText": {
            "description": "`09:14`.",
            "type": "string"
          },
          "steps": {
            "description": "Its steps, oldest first.",
            "items": {
              "$ref": "#/components/schemas/RunStep"
            },
            "type": "array"
          }
        },
        "required": [
          "runId",
          "startedAt",
          "startedText",
          "steps"
        ],
        "type": "object"
      },
      "RunsResponse": {
        "description": "`GET /surface/workflow/sessions/{session}/runs`.",
        "properties": {
          "graph": {
            "description": "The graph agent.",
            "type": "string"
          },
          "lineage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunLineage"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the thread was forked from."
          },
          "removedBefore": {
            "description": "The first step still kept, when retention removed the ones before it.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "runs": {
            "description": "Every run whose records are kept, oldest first.",
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array"
          },
          "sessionId": {
            "description": "The session.",
            "type": "string"
          },
          "threadId": {
            "description": "The session's checkpoint thread.",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "graph",
          "threadId",
          "runs"
        ],
        "type": "object"
      },
      "StateChange": {
        "description": "One key of \"What changed\" (spec 3.3 §12): computed here so the web pane and the terminal\nshow the same diff. Values pass secret redaction, the host's hidden keys and a size cap.",
        "properties": {
          "after": {
            "description": "The value after; absent when removed."
          },
          "before": {
            "description": "The value before; absent when added."
          },
          "change": {
            "$ref": "#/components/schemas/Change",
            "description": "How it changed."
          },
          "changeText": {
            "description": "\"Added\", \"Changed\" or \"Removed\".",
            "type": "string"
          },
          "key": {
            "description": "The key.",
            "type": "string"
          },
          "note": {
            "description": "Why a value is not shown as it is: \"Hidden: looks like a secret\".",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "change",
          "changeText"
        ],
        "type": "object"
      },
      "StepDetail": {
        "description": "`GET /surface/workflow/sessions/{session}/checkpoints/{id}`: one step, from one\ncheckpoint (spec 3.3 §12). Reading it changes nothing.",
        "properties": {
          "atText": {
            "description": "When it started: `09:14:03`.",
            "type": "string"
          },
          "changes": {
            "description": "What changed, by key.",
            "items": {
              "$ref": "#/components/schemas/StateChange"
            },
            "type": "array"
          },
          "checkpointId": {
            "description": "The checkpoint.",
            "type": "string"
          },
          "fork": {
            "$ref": "#/components/schemas/ForkPoint",
            "description": "What a fork from here would do."
          },
          "label": {
            "description": "\"Step 2\".",
            "type": "string"
          },
          "nodes": {
            "description": "The step's nodes.",
            "items": {
              "$ref": "#/components/schemas/NodeDetail"
            },
            "type": "array"
          },
          "sessionId": {
            "description": "The session.",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/StepState",
            "description": "How the step ended."
          },
          "stateValues": {
            "description": "The state at this checkpoint, one row per channel.",
            "items": {
              "$ref": "#/components/schemas/ChannelValue"
            },
            "type": "array"
          },
          "step": {
            "description": "The step's label.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sessionId",
          "checkpointId",
          "step",
          "label",
          "state",
          "atText",
          "nodes",
          "changes",
          "stateValues",
          "fork"
        ],
        "type": "object"
      },
      "StepState": {
        "description": "How a step ended, as the run view lists it.",
        "oneOf": [
          {
            "const": "input",
            "description": "The person's message, which started the run.",
            "type": "string"
          },
          {
            "const": "completed",
            "description": "Every node finished.",
            "type": "string"
          },
          {
            "const": "paused",
            "description": "A node paused or waits.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "A node failed.",
            "type": "string"
          }
        ]
      },
      "WorkflowChanged": {
        "description": "A `changed` frame of the feed: the thread's newest checkpoint version.",
        "properties": {
          "version": {
            "description": "The newest checkpoint version.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      },
      "WorkflowRun": {
        "description": "A run of a session's graph, as the Runs tab shows it (spec 3.3 §12).\n\nBuilt from the checkpoints' run and step records, the effect log and the inbox; never\nfrom agent output.",
        "properties": {
          "durationMs": {
            "description": "From the start to its latest checkpoint, in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "description": "The error a failed run ended with.",
            "type": [
              "string",
              "null"
            ]
          },
          "forks": {
            "description": "The forks made from this thread, newest first.",
            "items": {
              "$ref": "#/components/schemas/ForkSummary"
            },
            "type": "array"
          },
          "graph": {
            "description": "The graph agent.",
            "type": "string"
          },
          "lineage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunLineage"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the thread was forked from."
          },
          "nodes": {
            "description": "Every node of the graph, as it stands in this run.",
            "items": {
              "$ref": "#/components/schemas/NodeRun"
            },
            "type": "array"
          },
          "question": {
            "description": "The question a paused node asked: \"Which month should the invoice cover?\".",
            "type": [
              "string",
              "null"
            ]
          },
          "removedBefore": {
            "description": "The first step still kept, when retention removed the ones before it: \"Steps before 12\nwere removed\".",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "runId": {
            "description": "The run's id: the invocation that started it. Absent before the first run.",
            "type": [
              "string",
              "null"
            ]
          },
          "sessionId": {
            "description": "The session.",
            "type": "string"
          },
          "startedAt": {
            "description": "When the run started.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus",
            "description": "How the run stands."
          },
          "statusText": {
            "description": "In words: \"Waiting for you\", \"Done\", …",
            "type": "string"
          },
          "steps": {
            "description": "The run's steps, oldest first.",
            "items": {
              "$ref": "#/components/schemas/RunStep"
            },
            "type": "array"
          },
          "summary": {
            "description": "\"Started 09:14 · 4.2 s · 3 steps\", or what there is to say before a run.",
            "type": "string"
          },
          "taken": {
            "description": "The edges the run took.",
            "items": {
              "$ref": "#/components/schemas/EdgeView"
            },
            "type": "array"
          },
          "threadId": {
            "description": "The session's checkpoint thread.",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "threadId",
          "graph",
          "status",
          "statusText",
          "summary",
          "nodes",
          "taken",
          "steps"
        ],
        "type": "object"
      }
    }
