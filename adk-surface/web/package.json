{
  "name": "adk-surface-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "The web home of adk-surface (spec 3.3 §5.1): React, Vite and TypeScript, built into ../assets/web",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "tsc -b --pretty false",
    "verify": "npm run check && npm test && npm run build",
    "e2e": "playwright test",
    "e2e:build": "node --experimental-strip-types e2e/build-servers.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
