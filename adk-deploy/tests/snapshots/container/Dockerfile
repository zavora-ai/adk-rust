# Generated by adk-deploy for support-desk 1.4.0. Regenerate with `cargo adk deploy --target container --plan`.
FROM rust:1.95-slim AS builder
WORKDIR /build
COPY . .
# One target directory whether or not the agent is a workspace member.
ENV CARGO_TARGET_DIR=/build/target
RUN cargo build --locked --profile release --manifest-path Cargo.toml --bin support-desk --features anthropic

FROM gcr.io/distroless/cc-debian12:nonroot
WORKDIR /app
COPY --from=builder /build/target/release/support-desk /app/agent
COPY --from=builder /build/prompts /app/prompts
ENV PORT=8080 BIND_HOST=0.0.0.0
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/app/agent"]
