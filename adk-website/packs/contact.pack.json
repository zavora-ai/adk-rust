{
  "format": "adk-website.pack/1",
  "name": "contact",
  "version": "1.0.0",
  "publisher": {
    "id": "adk-website",
    "name": "ADK-Rust adk-website"
  },
  "description": "Enquiries, newsletter sign-ups, prospectus requests, licensing enquiries, volunteering and service forms",
  "capabilities": [
    {
      "name": "submit_inquiry",
      "description": "Send the site's owner an enquiry",
      "effect": "non_idempotent",
      "minTrust": "public",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "message": {
            "maxLength": 5000,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "message"
        ],
        "type": "object"
      },
      "consent": {
        "scope": "contact",
        "policyVersion": "1"
      },
      "approval": {
        "mode": "never"
      },
      "idempotency": "binding"
    },
    {
      "name": "subscribe_newsletter",
      "description": "Subscribe to the site's newsletter",
      "effect": "idempotent",
      "minTrust": "public",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "consent": {
        "scope": "newsletter",
        "policyVersion": "1"
      },
      "approval": {
        "mode": "never"
      },
      "idempotency": "binding"
    },
    {
      "name": "request_prospectus",
      "description": "Request a prospectus",
      "effect": "non_idempotent",
      "minTrust": "public",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "programme": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "type": "object"
      },
      "consent": {
        "scope": "contact",
        "policyVersion": "1"
      },
      "approval": {
        "mode": "never"
      },
      "idempotency": "binding"
    },
    {
      "name": "licensing_enquiry",
