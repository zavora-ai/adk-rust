      "effect": "non_idempotent",
      "minTrust": "public",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "items": {
            "items": {
              "maxLength": 500,
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "organisation": {
            "maxLength": 200,
            "type": "string"
          },
          "use": {
            "maxLength": 2000,
            "type": "string"
          }
        },
        "required": [
          "organisation",
          "email",
          "use"
        ],
        "type": "object"
      },
      "consent": {
        "scope": "contact",
        "policyVersion": "1"
      },
      "approval": {
        "mode": "never"
      },
      "idempotency": "binding"
    },
    {
      "name": "volunteer",
      "description": "Offer to volunteer",
      "effect": "non_idempotent",
      "minTrust": "public",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "maxLength": 500,
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "interests": {
            "maxLength": 1000,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "type": "object"
      },
      "consent": {
        "scope": "contact",
        "policyVersion": "1"
      },
      "approval": {
        "mode": "never"
      },
      "idempotency": "binding"
    },
    {
      "name": "submit_service_form",
      "description": "Apply for a public service; the applicant's identity comes from a verified identity provider",
      "effect": "non_idempotent",
      "minTrust": "verified",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "maxProperties": 50,
            "type": "object"
          },
          "service": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "service",
          "fields"
        ],
        "type": "object"
      },
      "consent": {
        "scope": "service",
        "policyVersion": "1"
      },
      "approval": {
        "mode": "never"
      },
