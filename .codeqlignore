# CodeQL ignore patterns for ADK-Rust
# These paths contain minified/bundled vendor code that triggers false positives

# The web home's production bundle, built from adk-surface/web
adk-surface/assets/web/*.js
adk-surface/assets/web/**/*.js

# Studio UI dist (Vite build output)
adk-studio/ui/dist/
adk-studio/ui/dist/**

# Node modules (should never be scanned)
**/node_modules/
**/node_modules/**

# Build artifacts
target/
target/**

# Test data and fixtures
**/test_data/
**/fixtures/
